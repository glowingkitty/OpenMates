{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/apple-no-delete-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/host-load-gate.sh pre-agent",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/bash-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/e2e-encryption-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/pre-edit-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/pii-logger-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/css-selector-in-specs.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/svelte5-legacy-syntax.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/native-ios-control-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/provider-registry-sync.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/analytics-sdk-forbidden.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/apple-no-delete-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/auto-track.sh",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/auto-rebuild-translations.sh",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/skill-embed-registry-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/specification-test-impact.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash scripts/lint-design-tokens.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash scripts/lint-swift-design-tokens.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/reinject-session.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/peer-chats.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/host-load-gate.sh session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/host-load-gate.sh prompt",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/peer-chats.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$(git rev-parse --show-toplevel)/.claude/hooks/check-uncommitted.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
