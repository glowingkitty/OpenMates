<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
		<string>$(AppIdentifierPrefix)org.openmates.app</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.openmates.app.shared</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:openmates.org</string>
		<string>$(OPENMATES_DEV_WEBCREDENTIALS)</string>
		<string>webcredentials:app.openmates.org</string>
		<string>applinks:app.openmates.org</string>
		<string>applinks:openmates.org</string>
		<string>applinks:app.dev.openmates.org</string>
	</array>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
