# status.openmates.org: static public page plus the agent's status.json.
# Gatus is not proxied: its UI shows internal check details.

{
	email letsencrypt83hd@openmates.org
}

{$STATUS_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
	}

	# No visitor IPs are logged (no access log directive).

	handle /data/status.json {
		root * /srv
		header Cache-Control "no-store"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	handle {
		root * /srv/site
		header Cache-Control "public, max-age=300"
		file_server
	}
}
