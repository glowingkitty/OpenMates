# Copy to /home/superdev/.config/openmates-backup/backup.env (mode 600).
# No secrets belong here: S3 keys are read from prod Vault at run time and the
# Discord webhook from the runtime .env.
OPENMATES_INSTALL_PATH=/home/superdev/openmates
OPENMATES_BACKUP_BUCKET=<dedicated-prod-backup-bucket>
OPENMATES_BACKUP_REGION=<hetzner-location, e.g. nbg1>
OPENMATES_BACKUP_PREFIX=prod/nightly
OPENMATES_BACKUP_STATE_KEY=prod/state/latest.json
OPENMATES_BACKUP_KEEP_COPIES=7
OPENMATES_BACKUP_RECIPIENT_FILE=/home/superdev/.config/openmates-backup/recipient.asc
# systemd does not read the login profile; include the directory of the `openmates` CLI.
PATH=/home/superdev/.local/bin:/home/superdev/.cargo/bin:/usr/local/bin:/usr/bin:/bin
