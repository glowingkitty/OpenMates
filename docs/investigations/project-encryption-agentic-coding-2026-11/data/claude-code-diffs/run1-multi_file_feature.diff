diff --git a/textstats/words.py b/textstats/words.py
index 690f1ce..8c0fa50 100644
--- a/textstats/words.py
+++ b/textstats/words.py
@@ -1,5 +1,7 @@
 """Word statistics for plain text."""
 
+from collections import Counter
+
 
 def count_words(text):
     """Return the number of words in text."""
@@ -15,3 +17,13 @@ def longest_word(text):
     """Return the longest word, or an empty string for empty text."""
     words = [word.strip(".,!?") for word in text.split()]
     return max(words, key=len) if words else ""
+
+
+def top_words(text, n=3):
+    """Return the n most common lower-case words as (word, count) tuples.
+
+    Most common first; ties broken alphabetically.
+    """
+    words = [word.lower().strip(".,!?") for word in text.split() if word.strip(".,!?")]
+    counts = Counter(words)
+    return sorted(counts.items(), key=lambda item: (-item[1], item[0]))[:n]
