     def test_longest_word(self):
         self.assertEqual(longest_word("a bb ccc"), "ccc")
 
+    def test_top_words_most_common_first(self):
+        self.assertEqual(
+            top_words("the cat the dog the cat"),
+            [("the", 3), ("cat", 2), ("dog", 1)],
+        )
+
+    def test_top_words_strips_punctuation_and_lowercases(self):
+        self.assertEqual(
+            top_words("The Cat. the cat! THE dog?", n=2),
+            [("the", 3), ("cat", 2)],
+        )
+
+    def test_top_words_ties_alphabetical(self):
+        self.assertEqual(top_words("dog cat bird", n=2), [("bird", 1), ("cat", 1)])
+
+    def test_top_words_default_n(self):
+        self.assertEqual(
+            top_words("a a b b c c d d"),
+            [("a", 2), ("b", 2), ("c", 2)],
+        )
+
+    def test_top_words_empty_text(self):
+        self.assertEqual(top_words(""), [])
+
 
 if __name__ == "__main__":
     unittest.main()
