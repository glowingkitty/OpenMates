diff --git a/specifications/features/notifications/specification.yml b/specifications/features/notifications/specification.yml
index 2454a22ef4..150c94884d 100644
--- a/specifications/features/notifications/specification.yml
+++ b/specifications/features/notifications/specification.yml
@@ -272,6 +272,10 @@ assertions:
     type: privacy
     must: Notification storage, logs, email payloads, push payloads, and history summaries avoid durable plaintext private chat, reminder, workflow, billing, or account-secret content unless that channel is explicitly user-addressed and authorized; encrypted or redacted summaries are used otherwise.
     depends_on: [models.NotificationHistoryItem.summary, models.PushSubscription.endpoint_ciphertext, examples.privacy_boundaries]
+  - id: notifications.chat.title-headline
+    type: privacy
+    must: A chat-message push shows the chat title as "<Mate> in <chat title>" by default, and the user can turn it off per channel (push preference includeChatTitle). The title is sealed to the receiving device inside the encrypted envelope and shown by the notification extension; APNs alert fields, notification history and public streams never carry it. It is the transient value of the current inference request, never a decrypted stored title. Email shows the same headline only under the existing include-content consent, because a mail provider and mailbox keep plaintext subjects. Where the title is unavailable (Apple Watch, team, direct and workflow-output messages) the generic text stays.
+    depends_on: [examples.chat_title_headline]
   - id: notifications.delivery.idempotent
     type: invariant
     must: Retries, duplicate workers, reconnects, and multi-device clients preserve one logical notification history item and at most one successful delivery per channel for the same notification id.
@@ -402,6 +406,7 @@ examples:
   - reminder_email_targets
   - reminder_email_preview_access
   - push_delivery
+  - chat_title_headline
   - notification_history
   - privacy_boundaries
   - delivery_idempotency
