{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "capabilities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work.project-workflow-file-sync.v1"
      ],
      "properties": {
        "work.project-workflow-file-sync.v1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account",
            "owner_id",
            "project_id",
            "workflow_id",
            "chat_id",
            "item_id",
            "team_id",
            "source_id",
            "source_session_id",
            "expected_version",
            "app_origin",
            "project_key_b64",
            "path",
            "old_yaml",
            "expected_yaml",
            "vectors"
          ],
          "properties": {
            "owner_id": {
              "type": "string"
            },
            "project_id": {
              "type": "string"
            },
            "workflow_id": {
              "type": "string"
            },
            "chat_id": {
              "type": "string"
            },
            "item_id": {
              "type": "string"
            },
            "team_id": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "source_session_id": {
              "type": "string"
            },
            "expected_version": {
              "type": "string"
            },
            "app_origin": {
              "type": "string"
            },
            "project_key_b64": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "old_yaml": {
              "type": "string"
            },
            "expected_yaml": {
              "type": "string"
            },
            "account": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "session_id",
                "cookie",
                "master_key",
                "hashed_email"
              ],
              "properties": {
                "session_id": {
                  "type": "string"
                },
                "cookie": {
                  "type": "string"
                },
                "master_key": {
                  "type": "string"
                },
                "hashed_email": {
                  "type": "string"
                }
              }
            },
            "vectors": {
              "type": "array",
              "minItems": 23,
              "maxItems": 23,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "create-saved",
                      "update-saved",
                      "approval-pending",
                      "unapproved-exact-path",
                      "apply-and-show",
                      "source-offline",
                      "source-missing",
                      "focus-mismatch",
                      "remote-queued",
                      "remote-conflict",
                      "tuple-ack",
                      "bad-after-hash",
                      "version-race",
                      "pending-404-rotation",
                      "unknown-404-no-retry",
                      "metadata-denied",
                      "cancel-held-result",
                      "foreign-item-scope",
                      "invalid-approval-path",
                      "no-auth",
                      "privacy-denial",
                      "ambiguous-team-scope",
                      "wrong-original-master"
                    ]
                  },
                  "mode": {
                    "type": "string"
                  },
                  "approved_paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "enum": [
                      "saved",
                      "pending",
                      "failed",
                      "conflict"
                    ]
                  },
                  "error": {
                    "type": "string"
                  },
                  "sdk_error": {
                    "type": "string"
                  },
                  "early": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
