{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provenance": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdk.docs"
      ],
      "properties": {
        "sdk.docs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api_key",
            "device_id",
            "vectors"
          ],
          "properties": {
            "api_key": {
              "const": "sk-api-docsOwnerA.localSetupSuffix"
            },
            "device_id": {
              "const": "synthetic-docs-device"
            },
            "vectors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "operation",
                  "query",
                  "slug",
                  "anonymous",
                  "http_status",
                  "response",
                  "expected_request_count",
                  "expected_error"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  },
                  "operation": {
                    "enum": [
                      "list",
                      "search",
                      "show",
                      "download"
                    ]
                  },
                  "query": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "slug": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "anonymous": {
                    "type": "boolean"
                  },
                  "http_status": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 599
                  },
                  "response": {},
                  "expected_request_count": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "expected_error": {
                    "enum": [
                      null,
                      "authentication",
                      "forbidden",
                      "invalid",
                      "conflict",
                      "offline",
                      "protocol"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
