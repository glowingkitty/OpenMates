{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved chat bounded read v1",
  "oneOf": [
    {
      "$ref": "#/$defs/options"
    },
    {
      "$ref": "#/$defs/exactOptions"
    }
  ],
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chatId",
        "scope",
        "createdAt",
        "messageId"
      ],
      "properties": {
        "chatId": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "messageId": {
          "$ref": "#/$defs/messageId"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 30
        },
        "before": {
          "$ref": "#/$defs/cursor"
        },
        "respectCompressionBoundary": {
          "type": "boolean",
          "default": true
        },
        "contentMode": {
          "enum": [
            "stored",
            "page_local"
          ]
        },
        "after": {
          "$ref": "#/$defs/cursor"
        },
        "anchorMessageId": {
          "$ref": "#/$defs/messageId"
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 5
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "before",
              "after"
            ]
          }
        },
        {
          "not": {
            "required": [
              "before",
              "anchorMessageId"
            ]
          }
        },
        {
          "not": {
            "required": [
              "after",
              "anchorMessageId"
            ]
          }
        }
      ]
    },
    "exactOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "contentMode": {
          "enum": [
            "stored",
            "page_local"
          ]
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "content",
        "sender",
        "thinking",
        "embeds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/messageId"
        },
        "role": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "thinking": {
          "type": "string"
        },
        "embeds": {
          "type": "array"
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat",
        "hasMoreBefore",
        "hasMoreAfter",
        "anchorFound",
        "startCursor",
        "endCursor",
        "serverMessageCount",
        "messagesVersion",
        "oversizedMessage",
        "oversizedMessageCursor",
        "payloadBytes",
        "piiRestoration",
        "historyComplete",
        "piiMappingsByMessageId",
        "contentMode",
        "pagesRead",
        "chatMetadata",
        "messageMetadata"
      ],
      "properties": {
        "chat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "category",
            "messages"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "messages": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/message"
              }
            }
          }
        },
        "hasMoreBefore": {
          "type": "boolean"
        },
        "hasMoreAfter": {
          "type": "boolean"
        },
        "anchorFound": {
          "type": "boolean"
        },
        "startCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "endCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "serverMessageCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "messagesVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "oversizedMessage": {
          "type": "boolean"
        },
        "oversizedMessageCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "payloadBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1310720
        },
        "piiRestoration": {
          "enum": [
            "stored",
            "page_local"
          ]
        },
        "historyComplete": {
          "const": false
        },
        "piiMappingsByMessageId": {
          "type": "object",
          "additionalProperties": {
            "type": "array"
          }
        },
        "contentMode": {
          "enum": [
            "stored",
            "page_local"
          ]
        },
        "pagesRead": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "chatMetadata": {
          "$ref": "#/$defs/chatMetadata"
        },
        "messageMetadata": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/messageMetadata"
          }
        }
      }
    },
    "exactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "piiMappings",
        "contentMode",
        "piiRestoration",
        "payloadBytes",
        "historyComplete",
        "chatMetadata",
        "messageMetadata"
      ],
      "properties": {
        "message": {
          "$ref": "#/$defs/message"
        },
        "piiMappings": {
          "type": [
            "array",
            "null"
          ]
        },
        "contentMode": {
          "enum": [
            "stored",
            "page_local"
          ]
        },
        "piiRestoration": {
          "enum": [
            "stored",
            "page_local"
          ]
        },
        "payloadBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "historyComplete": {
          "const": false
        },
        "chatMetadata": {
          "$ref": "#/$defs/chatMetadata"
        },
        "messageMetadata": {
          "$ref": "#/$defs/messageMetadata"
        }
      }
    },
    "chatMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "category",
        "slug",
        "activeFocusId",
        "createdAt",
        "lastEditedAt",
        "metadataUpdatedAt",
        "parentId",
        "isSubChat",
        "isHidden",
        "pinned",
        "chatVisibility",
        "participantUserHashes",
        "hasDraft",
        "followUpSuggestions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeFocusId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastEditedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "metadataUpdatedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "isSubChat": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "isHidden": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pinned": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "chatVisibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "participantUserHashes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "hasDraft": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "followUpSuggestions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "messageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "storageId",
        "sourceMessageId",
        "clientMessageId",
        "chatId",
        "createdAt",
        "rawStatus",
        "senderName",
        "category",
        "modelName",
        "thinkingSignature",
        "hasThinking",
        "thinkingTokenCount",
        "hashedUserId",
        "userMessageId",
        "keyVersion",
        "queueRevision",
        "queueMode",
        "queueDispatchStatus",
        "queueDispatchMode",
        "queueDispatchTaskId",
        "embedIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "storageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceMessageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientMessageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "chatId": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rawStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "senderName": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelName": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinkingSignature": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasThinking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "thinkingTokenCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hashedUserId": {
          "type": [
            "string",
            "null"
          ]
        },
        "userMessageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "keyVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queueRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queueMode": {
          "type": [
            "string",
            "null"
          ]
        },
        "queueDispatchStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "queueDispatchMode": {
          "type": [
            "string",
            "null"
          ]
        },
        "queueDispatchTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "fullRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "messages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "slug": {
          "type": "string"
        }
      }
    },
    "chatDetailsRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat",
        "messages",
        "follow_up_suggestions"
      ],
      "properties": {
        "chat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "chatVisibility",
            "shortId",
            "slug",
            "title",
            "summary",
            "createdAt",
            "updatedAt",
            "category",
            "mateName",
            "parentId",
            "isSubChat",
            "isHiddenCandidate",
            "isHidden",
            "pinned",
            "hasDraft",
            "draftPreview",
            "metadataUpdatedAt"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "chatVisibility": {
              "enum": [
                "personal",
                "team",
                "direct"
              ]
            },
            "participantUserHashes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "shortId": {
              "type": "string"
            },
            "slug": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "createdAt": {
              "type": [
                "number",
                "null"
              ]
            },
            "updatedAt": {
              "type": [
                "number",
                "null"
              ]
            },
            "category": {
              "type": [
                "string",
                "null"
              ]
            },
            "mateName": {
              "type": [
                "string",
                "null"
              ]
            },
            "parentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "isSubChat": {
              "type": "boolean"
            },
            "isHiddenCandidate": {
              "type": "boolean"
            },
            "isHidden": {
              "type": "boolean"
            },
            "pinned": {
              "type": "boolean"
            },
            "hasDraft": {
              "type": "boolean"
            },
            "draftPreview": {
              "type": [
                "string",
                "null"
              ]
            },
            "metadataUpdatedAt": {
              "type": "number"
            },
            "activeFocusId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "clientMessageId",
              "chatId",
              "role",
              "content",
              "senderName",
              "hashedSenderUserId",
              "category",
              "modelName",
              "createdAt",
              "embedIds"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "clientMessageId": {
                "type": "string"
              },
              "chatId": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "senderName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hashedSenderUserId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "modelName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "createdAt": {
                "type": "number"
              },
              "embedIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "piiMappings": {}
            }
          }
        },
        "follow_up_suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "has_more_before": {
          "type": "boolean"
        }
      }
    },
    "chatDetailsOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "full"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "limit"
              ],
              "properties": {
                "kind": {
                  "const": "latest"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          ]
        },
        "content_mode": {
          "enum": [
            "stored",
            "page_local"
          ]
        }
      }
    }
  }
}
