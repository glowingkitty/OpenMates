{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "provenance",
    "key_b64",
    "metadata_epoch",
    "rest_failures",
    "metadata_cases",
    "success_request_budget",
    "cold_request_budget",
    "phase",
    "forbid",
    "version_floor_cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provenance": {
      "type": "string"
    },
    "key_b64": {
      "type": "string"
    },
    "metadata_epoch": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "rest_failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "error",
          "http_status",
          "fallback"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "error": {
            "enum": [
              "offline",
              "expired",
              "authentication",
              "forbidden",
              "cancelled",
              "crypto",
              "protocol",
              "conflict"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "fallback": {
            "type": "boolean"
          }
        }
      }
    },
    "metadata_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "payload",
          "expect"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "expect": {
            "enum": [
              "ignored",
              "metadata",
              "reject"
            ]
          }
        }
      }
    },
    "success_request_budget": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cold_request_budget": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase": {
      "const": "phase2"
    },
    "forbid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version_floor_cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "cached",
          "metadata",
          "reject"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "cached": {
            "type": "integer",
            "minimum": 0
          },
          "metadata": {
            "type": "integer",
            "minimum": 0
          },
          "observed": {
            "type": "integer",
            "minimum": 0
          },
          "cleared": {
            "type": "integer",
            "minimum": 1
          },
          "cached_clear": {
            "type": "boolean"
          },
          "reject": {
            "type": "boolean"
          },
          "cached_absent": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
