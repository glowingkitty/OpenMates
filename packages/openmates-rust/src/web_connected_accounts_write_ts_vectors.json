      "out": {"kind": "ok",
        "keys": ["id", "encrypted_provider_type", "provider_type_hash", "encrypted_account_label", "encrypted_refresh_token_bundle", "encrypted_capabilities", "encrypted_app_permissions", "encrypted_account_directory_hint", "provider_account_id_hash", "encrypted_provider_account_display"],
        "row": {
          "id": "acct-1",
          "encrypted_provider_type": "enc:google_calendar",
          "provider_type_hash": "sha:google_calendar",
          "encrypted_account_label": "enc:Work",
          "encrypted_refresh_token_bundle": "enc:{\"refresh_token\":\"placeholder-refresh-1\",\"scopes\":[\"b\"]}",
          "encrypted_capabilities": "enc:[\"read\",\"write\"]",
          "encrypted_app_permissions": "enc:{\"app_id\":\"calendar\",\"allowed_actions\":[\"read\",\"write\",\"update\"],\"scopes\":[\"s1\"]}",
          "encrypted_account_directory_hint": "enc:{\"account_ref\":\"ref-1\",\"label\":\"Work\",\"capabilities\":[\"read\",\"write\"],\"runtime_modes\":{\"read\":\"allow_automatically\",\"write\":\"always_ask\",\"update\":\"always_ask\"}}",
          "provider_account_id_hash": "sha:pa-1",
