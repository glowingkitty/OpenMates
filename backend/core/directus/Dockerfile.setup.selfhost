FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0

WORKDIR /usr/src/app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY setup /usr/src/app
COPY setup/accountability_policy.py /usr/src/app/accountability_policy.py
COPY schemas /usr/src/app/schemas
COPY setup/migrate_chat_recovery_unique_indexes.sql /usr/src/app/migrations/migrate_chat_recovery_unique_indexes.sql
COPY setup/migrate_storage_replication_indexes.sql /usr/src/app/migrations/migrate_storage_replication_indexes.sql
COPY setup/migrate_storage_query_indexes.sql /usr/src/app/migrations/migrate_storage_query_indexes.sql
COPY setup/migrate_storage_billing_indexes.sql /usr/src/app/migrations/migrate_storage_billing_indexes.sql
COPY setup/migrate_storage_usage_metering_indexes.sql /usr/src/app/migrations/migrate_storage_usage_metering_indexes.sql
COPY setup/migrate_chat_message_archive_indexes.sql /usr/src/app/migrations/migrate_chat_message_archive_indexes.sql
COPY setup/migrate_chat_recovery_outputs_indexes.sql /usr/src/app/migrations/migrate_chat_recovery_outputs_indexes.sql
COPY setup/migrate_workflow_runtime_indexes.sql /usr/src/app/migrations/migrate_workflow_runtime_indexes.sql
COPY setup/migrate_user_chat_preferences_indexes.sql /usr/src/app/migrations/migrate_user_chat_preferences_indexes.sql
COPY setup/migrate_notification_email_preferences.sql /usr/src/app/migrations/migrate_notification_email_preferences.sql
COPY setup/migrate_user_task_indexes.sql /usr/src/app/migrations/migrate_user_task_indexes.sql
COPY setup/migrate_user_work_control_indexes.sql /usr/src/app/migrations/migrate_user_work_control_indexes.sql
COPY setup/migrate_usage_overview_indexes.sql /usr/src/app/migrations/migrate_usage_overview_indexes.sql
COPY setup/migrate_project_owner_context.sql /usr/src/app/migrations/migrate_project_owner_context.sql
COPY setup/migrate_encrypted_slug_indexes.sql /usr/src/app/migrations/migrate_encrypted_slug_indexes.sql
COPY setup/migrate_sub_chat_orchestration_indexes.sql /usr/src/app/migrations/migrate_sub_chat_orchestration_indexes.sql
COPY setup/migrate_user_chat_preferences_indexes.sql /usr/src/app/migrations/migrate_user_chat_preferences_indexes.sql
COPY setup/migrate_remove_ai_memories.sql /usr/src/app/migrations/migrate_remove_ai_memories.sql
COPY setup/migrate_apps_workspace_result_indexes.sql /usr/src/app/migrations/migrate_apps_workspace_result_indexes.sql

RUN pip install --no-cache-dir requests pyyaml python-dotenv "psycopg[binary]" \
    && chmod +x setup_schemas.py

CMD ["python", "setup_schemas.py"]
