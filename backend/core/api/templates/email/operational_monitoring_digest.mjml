<mjml>
  <mj-head>
    <mj-title>OpenMates operational report</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#e7e7ec" line-height="1.4" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#0f1016">
    <mj-section background-color="#191c26" border-radius="12px" padding="24px">
      <mj-column>
        <mj-text font-size="25px" font-weight="bold" padding-bottom="4px">{{ test_label }}{{ environment_label }} operational report</mj-text>
        <mj-text font-size="13px" color="#aeb0ba" padding-bottom="18px">{{ window_start }} to {{ window_end }}</mj-text>
        <mj-image src="cid:operational-report" alt="CPU, memory and disk usage over the preceding 24 hours" padding="0 0 18px 0" />
        <mj-text font-size="16px"><strong>Activity:</strong> {{ activity.chats }} chats · {{ activity.messages }} messages · {{ activity.embeds }} embeds · {{ activity.usage_entries }} usage entries</mj-text>
        <mj-text font-size="16px"><strong>AI response recovery jobs:</strong> {{ processing.created }} created · {{ processing.completed }} completed · {{ processing.invalidated }} invalidated · {{ processing.non_terminal_over_15m }} non-terminal &gt;15m</mj-text>
        {% if provider_health %}
        <mj-text font-size="16px"><strong>Providers:</strong> {{ provider_health.healthy_count }} healthy · {{ provider_health.status }}</mj-text>
        {% endif %}
        {% if billing_readiness %}
        <mj-text font-size="16px"><strong>Payment readiness:</strong> EU {{ billing_readiness.eu_card }} · Managed {{ billing_readiness.managed }} · {{ billing_readiness.status }}</mj-text>
        {% endif %}
        {% if cloud %}
        <mj-text font-size="16px"><strong>Cloud credit purchases ({{ cloud.purchase_window_label }}):</strong> {{ cloud.purchase_count }} purchases · {{ cloud.credits_sold }} credits sold · {{ cloud.status }}</mj-text>
        <mj-text font-size="16px"><strong>Usage charging:</strong> {{ cloud.usage_committed }} committed · {{ cloud.usage_failed }} failed</mj-text>
        <mj-text font-size="16px"><strong>Open purchase issues:</strong> {{ cloud.bank_review }} bank review · {{ cloud.refund_failed }} failed refunds · {{ cloud.chargebacks }} chargebacks · {{ cloud.incomplete_settlements }} incomplete settlements</mj-text>
        {% endif %}
        <mj-text font-size="14px" color="#aeb0ba"><strong>Telemetry:</strong> resources {{ freshness.resource_metrics }} · application {{ freshness.application_metrics }} · scheduler {{ freshness.report_scheduler }}</mj-text>
        <mj-text font-size="18px" font-weight="bold" padding-top="12px">Prioritized issues</mj-text>
        {% if issues %}
        {% for issue in issues %}
        <mj-text font-size="14px" padding="3px 0">{{ issue.severity | upper }} · {{ issue.fingerprint }} · {{ issue.count }}x</mj-text>
        {% endfor %}
        {% else %}
        <mj-text font-size="14px" color="#70d69b">No prioritized issues.</mj-text>
        {% endif %}
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
