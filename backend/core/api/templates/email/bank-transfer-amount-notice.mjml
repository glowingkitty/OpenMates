<mjml>
  <mj-head>
    <mj-title>OpenMates bank transfer update</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="center" font-weight="bold" line-height="1.3"/>
      {% if darkmode %}
      <mj-text color="#e6e6e6" />
      {% else %}
      <mj-text color="#000000" />
      {% endif %}
    </mj-attributes>
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="{% if darkmode == False %}light-mode{% else %}dark-mode{% endif %}">
    <mj-include path="./components/header.mjml" />

    <mj-wrapper css-class="content-box" padding="20px" padding-bottom="0">
      <mj-section padding-bottom="10px">
        <mj-column>
          <mj-image width="50px" height="50px" src="icons/coins.png" align="center" alt="Credits icon" css-class="email-icon-50" />
          <mj-text font-size="26px">
            <mark>Bank transfer update</mark>
          </mj-text>

          {% if notice_type == "underpaid" %}
          <mj-text font-size="16px" padding-bottom="10px">
            We received €{{ received_amount_eur }} for your {{ credits_amount }} credit purchase, but the selected pack costs €{{ expected_amount_eur }}.
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            Please send the remaining €{{ remaining_amount_eur }} using the same payment reference below. We will credit the selected pack automatically once the total received amount reaches €{{ expected_amount_eur }}.
          </mj-text>
          {% else %}
          <mj-text font-size="16px" padding-bottom="10px">
            We received €{{ received_amount_eur }} for your {{ credits_amount }} credit purchase. The selected pack costs €{{ expected_amount_eur }}, so your account was credited with exactly the selected pack.
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            Please contact <a href="{{ support_mailto }}">{{ support_email }}</a> and tell us what you would prefer us to do with the extra €{{ overpaid_amount_eur }}.
          </mj-text>
          {% endif %}
        </mj-column>
      </mj-section>

      <mj-section padding="10px 20px">
        <mj-column>
          <mj-text align="left" font-size="12px" color="#888888" font-weight="normal" padding-bottom="2px">Payment reference</mj-text>
          <mj-text align="left" font-size="18px" font-weight="bold" color="#d32f2f" padding-bottom="12px">{{ reference }}</mj-text>

          <mj-text align="left" font-size="12px" color="#888888" font-weight="normal" padding-bottom="2px">Expected amount</mj-text>
          <mj-text align="left" font-size="16px" font-weight="bold" padding-bottom="12px">€{{ expected_amount_eur }}</mj-text>

          <mj-text align="left" font-size="12px" color="#888888" font-weight="normal" padding-bottom="2px">Received so far</mj-text>
          <mj-text align="left" font-size="16px" font-weight="bold" padding-bottom="12px">€{{ received_amount_eur }}</mj-text>

          {% if notice_type == "underpaid" %}
          <mj-text align="left" font-size="12px" color="#888888" font-weight="normal" padding-bottom="2px">Remaining amount</mj-text>
          <mj-text align="left" font-size="16px" font-weight="bold" padding-bottom="12px">€{{ remaining_amount_eur }}</mj-text>
          {% if expires_at_formatted %}
          <mj-text align="left" font-size="12px" color="#888888" font-weight="normal" padding-bottom="2px">Updated transfer deadline</mj-text>
          <mj-text align="left" font-size="14px" font-weight="normal" padding-bottom="20px">{{ expires_at_formatted }}</mj-text>
          {% endif %}
          {% else %}
          <mj-text align="left" font-size="12px" color="#888888" font-weight="normal" padding-bottom="2px">Extra amount</mj-text>
          <mj-text align="left" font-size="16px" font-weight="bold" padding-bottom="20px">€{{ overpaid_amount_eur }}</mj-text>
          {% endif %}
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
