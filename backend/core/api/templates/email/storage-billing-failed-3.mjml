<mjml>
  <mj-head>
    <mj-title>{{ t.email.storage_billing_notice_3.subject.text }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="center" font-weight="bold" line-height="1.3" />
      {% if darkmode %}
      <mj-text color="#e6e6e6" />
      {% else %}
      <mj-text color="#000000" />
      {% endif %}
    </mj-attributes>
    <!-- Include styles from separate file -->
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="{% if darkmode %}dark-mode{% else %}light-mode{% endif %}">
    <!-- Header -->
    <mj-include path="./components/header.mjml" />

    <!-- Main Content -->
    <mj-wrapper css-class="content-box" padding="20px" padding-bottom="0">
      <mj-section>
        <mj-column>
          <mj-image width="50px" height="50px" src="icons/coins.png" align="center" css-class="email-icon-50" />
          <mj-text font-size="30px">
            <mark>{{ t.email.storage_billing_notice_3.header.text }}</mark>
          </mj-text>
          <mj-text padding-bottom="30px">
            {{ t.email.storage_billing_notice_3.body.text }}
          </mj-text>
          <mj-text padding-bottom="20px" color="{{ '#cccccc' if darkmode else '#555555' }}" font-size="14px">
            {{ t.email.storage_billing_notice_date_policy.text }}
          </mj-text>
          <mj-text padding-bottom="40px" color="{{ '#cccccc' if darkmode else '#555555' }}" font-size="14px">
            {{ t.email.storage_billing_notice_3.action.text }}
          </mj-text>
          <mj-text font-size="14px">{{ t.email.storage_billing_notice_affected.text }}</mj-text>
          {% for unit in affected_units %}
          <mj-text font-size="13px" align="left">
            {% if unit.kind == 'upload' %}{{ t.email.storage_billing_notice_unit_upload.text }}{% elif unit.kind == 'cold_chat' %}{{ t.email.storage_billing_notice_unit_cold_chat.text }}{% else %}{{ t.email.storage_billing_notice_unit_artifact_history.text }}{% endif %}
            · {{ unit.resource_id }} · {{ unit.oldest_date }} UTC · {{ unit.size_mib }} MiB
          </mj-text>
          {% endfor %}
          <mj-text font-size="14px">{{ t.email.storage_billing_notice_waiver.text }}</mj-text>
          <mj-button background-color="#4867CD" color="white" href="{{ storage_url }}" border-radius="20px">
            {{ t.email.storage_billing_notice_units_link.text }}
          </mj-button>
          <mj-button background-color="#4867CD" color="white" href="{{ credits_url }}" font-family="Arial, sans-serif" padding-bottom="40px" border-radius="20px">
            {{ t.email.storage_billing_notice_top_up.text }}
          </mj-button>
          <mj-button background-color="#4867CD" color="white" href="{{ export_url }}" font-family="Arial, sans-serif" padding-bottom="40px" border-radius="20px">
            {{ t.email.storage_billing_notice_export.text }}
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Footer -->
    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
