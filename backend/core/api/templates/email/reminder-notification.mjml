<mjml>
  <mj-head>
    <mj-title>{{ t.email.reminder_notification.subject.text }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="center" font-weight="bold" line-height="1.3" />
      <mj-text color="{% if darkmode %}#e6e6e6{% else %}#000000{% endif %}" />
    </mj-attributes>
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="{% if darkmode %}dark-mode{% else %}light-mode{% endif %}">
    <mj-include path="./components/header.mjml" />
    <mj-wrapper css-class="content-box" padding="20px" padding-bottom="0">
      <mj-section padding-bottom="0">
        <mj-column>
          <mj-image width="50px" height="50px" src="{{ notification_icon_url }}" align="center" alt="{{ t.email.reminder_notification.header.text }}" css-class="email-icon-50" />
          <mj-text font-size="30px" padding-bottom="8px">
            <mark>{{ t.email.reminder_notification[heading_key].text }}</mark>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          {% if preview_url %}
          <mj-image width="412px" src="{{ preview_url }}" href="{{ chat_url }}" alt="{{ target_title }}" border-radius="30px" padding="10px 25px 18px" />
          {% endif %}
          {% if target_title %}
          <mj-text align="left" font-size="20px" padding="10px 25px 10px">{{ target_title | safe }}</mj-text>
          {% endif %}
          {% if description %}
          <mj-text align="left" font-weight="normal" line-height="1.5" padding="0 25px 12px">{{ description | safe }}</mj-text>
          {% endif %}
          {% if event_time or location %}
          <mj-text align="left" line-height="1.5" padding="0 25px 12px">
            {% if event_time %}{{ event_time | safe }}{% endif %}
            {% if event_time and location %}<br/>{% endif %}
            {% if location %}{{ location | safe }}{% endif %}
          </mj-text>
          {% endif %}
          {% for fact in facts %}
          <mj-text align="left" font-weight="normal" line-height="1.5" padding="0 25px 6px"><strong>{{ fact.label | safe }}:</strong> {{ fact.value | safe }}</mj-text>
          {% endfor %}
          {% if show_prompt %}
          <mj-text align="left" font-weight="normal" line-height="1.5" padding="10px 25px 18px">
            <strong>{{ t.email.reminder_notification.task_label.text if is_new_chat else t.email.reminder_notification.reminder_label.text }}:</strong><br/>
            {{ reminder_prompt | safe }}
          </mj-text>
          {% elif not target_title and not description %}
          <mj-text align="left" font-weight="normal" line-height="1.5" padding="10px 25px 18px">{{ t.email.reminder_notification.description.text }}</mj-text>
          {% endif %}
          <mj-text align="left" font-weight="normal" font-size="14px" color="{% if darkmode %}#cfcfcf{% else %}#6b6b6b{% endif %}" padding="0 25px 20px">
            {{ t.email.reminder_notification.trigger_time_label.text }}: {{ trigger_time | safe }}
          </mj-text>
        </mj-column>
      </mj-section>
      {% if chat_url %}
      <mj-section padding="20px 0">
        <mj-column>
          <mj-button href="{{ chat_url }}" background-color="#ff553b" color="#ffffff" border-radius="20px" font-size="16px" font-weight="bold" padding="12px 20px" inner-padding="13px 22px">{{ t.email.reminder_notification[button_key].text }}</mj-button>
        </mj-column>
      </mj-section>
      {% endif %}
    </mj-wrapper>
    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
