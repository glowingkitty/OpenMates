<mjml>
  <mj-head>
    <mj-title>OpenMates nightly tests</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#e6e6e6" font-size="15px" line-height="1.5" align="left" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#15161c">
    <mj-section padding="22px 16px 8px">
      <mj-column>
        <mj-text font-size="14px" color="#a9adb8" padding="0 0 8px">OpenMates nightly tests · {{ daily_digest.date }}</mj-text>
        <mj-text font-size="27px" font-weight="bold" padding="0 0 8px">{{ daily_digest.status }}</mj-text>
        <mj-text font-size="13px" color="#a9adb8" padding="0 0 12px">Source {{ daily_digest.source }}</mj-text>
      </mj-column>
    </mj-section>
    {% for row in daily_digest.rows %}
    <mj-section background-color="#242630" padding="0 16px" border-bottom="1px solid #3c3e48">
      <mj-column>
        <mj-text font-size="17px" font-weight="bold" padding="14px 0 2px">{{ row.name }}</mj-text>
        <mj-text font-size="15px" padding="0">{{ row.executed }} executed · {{ row.passed }} passed · {{ row.failed }} failed · {{ row.skipped }} skipped</mj-text>
        {% if row.detail %}<mj-text font-size="13px" color="#bbc0cb" padding="2px 0 14px">{{ row.detail }}</mj-text>{% endif %}
      </mj-column>
    </mj-section>
    {% endfor %}
    <mj-section padding="16px 16px 0">
      <mj-column>
        <mj-text font-size="15px" font-weight="bold" padding="0 0 4px">Signup</mj-text>
        <mj-text padding="0 0 14px">{{ daily_digest.signup }}</mj-text>
        {% if daily_digest.highlights %}
        <mj-text font-size="15px" font-weight="bold" padding="0 0 4px">Needs attention</mj-text>
        {% for item in daily_digest.highlights %}<mj-text padding="0 0 5px">• {{ item }}</mj-text>{% endfor %}
        {% endif %}
        {% if daily_digest.report_url %}
        <mj-button href="{{ daily_digest.report_url }}" background-color="#facc15" color="#15161c" font-weight="bold" align="left" padding="18px 0">Open full results</mj-button>
        {% endif %}
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
