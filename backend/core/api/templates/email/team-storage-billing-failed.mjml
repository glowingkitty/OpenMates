<mjml>
  <mj-head>
    <mj-title>{{ t.email.team_storage_billing_notice.subject.text }}</mj-title>
    <mj-attributes><mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="center" line-height="1.3" /></mj-attributes>
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="{% if darkmode %}dark-mode{% else %}light-mode{% endif %}">
    <mj-include path="./components/header.mjml" />
    <mj-wrapper css-class="content-box" padding="20px">
      <mj-section><mj-column>
        <mj-text font-size="26px">{{ t.email.team_storage_billing_notice.header.text }}</mj-text>
        <mj-text>{{ t.email.team_storage_billing_notice.body.text }}</mj-text>
        <mj-text>{{ t.email.team_storage_billing_notice.action.text }}</mj-text>
        <mj-text font-size="14px">{{ t.email.storage_billing_notice_affected.text }}</mj-text>
        {% for unit in affected_units %}
        <mj-text font-size="13px" align="left">{{ unit.kind }} · {{ unit.resource_id }} · {{ unit.oldest_date }} UTC · {{ unit.size_mib }} MiB</mj-text>
        {% endfor %}
        <mj-button background-color="#4867CD" color="white" href="{{ team_url }}" border-radius="20px">{{ t.email.team_storage_billing_notice.open_team.text }}</mj-button>
      </mj-column></mj-section>
    </mj-wrapper>
    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
