<mjml>
  <mj-head>
    <mj-title>{{ t.email.workflow_digest.subject.text }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="left" line-height="1.5" />
      <mj-text color="{% if darkmode %}#e6e6e6{% else %}#000000{% endif %}" />
    </mj-attributes>
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="{% if darkmode %}dark-mode{% else %}light-mode{% endif %}">
    <mj-include path="./components/header.mjml" />
    <mj-wrapper css-class="content-box" padding="20px">
      <mj-section padding-bottom="0"><mj-column>
        <mj-image width="50px" height="50px" src="{{ notification_icon_url | e }}" align="center" alt="{{ t.email.workflow_digest.heading.text }}" css-class="email-icon-50" />
        <mj-text align="center" font-size="30px" font-weight="bold"><mark>{{ t.email.workflow_digest.heading.text }}</mark></mj-text>
        <mj-text>{{ t.email.workflow_digest.intro.text }}</mj-text>
        <mj-text font-size="13px">{{ t.email.workflow_digest.period.text }}: {{ window_start }} – {{ window_end }}</mj-text>
        <mj-text><strong>{{ t.email.workflow_digest.workflows.text }}: {{ workflow_count }} · {{ t.email.workflow_digest.runs.text }}: {{ run_count }}</strong></mj-text>
        <mj-text font-size="14px">
          {% for status, count in status_counts.items() %}
          {{ t.email.workflow_digest[status if status not in ['skipped_by_user'] else 'skipped'].text }}: {{ count }}{% if not loop.last %} · {% endif %}
          {% endfor %}
        </mj-text>
        <mj-text font-size="14px"><strong>{{ t.email.workflow_digest.delivery_heading.text }}:</strong><br />
          {{ t.email.workflow_digest.pending.text }}: {{ delivery_pending_count }} ·
          {{ t.email.workflow_digest.acknowledged.text }}: {{ delivery_acknowledged_count }} ·
          {{ t.email.workflow_digest.cancelled.text }}: {{ delivery_cancelled_count }} ·
          {{ t.email.workflow_digest.expired.text }}: {{ delivery_expired_count }} ·
          {{ t.email.workflow_digest.failed.text }}: {{ delivery_failed_count }}
        </mj-text>
        <mj-text font-size="13px">{{ t.email.workflow_digest.delivery_note.text }}</mj-text>
      </mj-column></mj-section>
      {% for row in rows %}
      <mj-section padding="10px 0"><mj-column background-color="{% if darkmode %}#303030{% else %}#ffffff{% endif %}" border-radius="24px" padding="12px 8px">
        <mj-text font-size="20px" font-weight="bold">{% if row.title %}{{ row.title | e }}{% else %}{{ t.email.workflow_digest.workflow.text }} {{ loop.index }}{% endif %}</mj-text>
        {% if row.attention %}<mj-text font-size="13px" font-weight="bold" padding-top="0">{{ t.email.workflow_digest.attention.text }}</mj-text>{% endif %}
        <mj-text font-size="14px" padding-top="0"><strong>{{ t.email.workflow_digest.runs.text }}: {{ row.run_count }}</strong><br />
          {% for status, count in row.status_counts.items() %}
          {{ t.email.workflow_digest[status if status not in ['skipped_by_user'] else 'skipped'].text }}: {{ count }}{% if not loop.last %} · {% endif %}
          {% endfor %}
        </mj-text>
        <mj-text font-size="13px" padding-top="0">{{ t.email.workflow_digest.last_activity.text }}: {{ row.activity_time }}</mj-text>
        {% if row.delivery_pending_count or row.delivery_acknowledged_count or row.delivery_cancelled_count or row.delivery_expired_count or row.delivery_failed_count %}
        <mj-text font-size="13px" padding-top="0"><strong>{{ t.email.workflow_digest.delivery_heading.text }}:</strong><br />
          {{ t.email.workflow_digest.pending.text }}: {{ row.delivery_pending_count }} ·
          {{ t.email.workflow_digest.acknowledged.text }}: {{ row.delivery_acknowledged_count }} ·
          {{ t.email.workflow_digest.cancelled.text }}: {{ row.delivery_cancelled_count }} ·
          {{ t.email.workflow_digest.expired.text }}: {{ row.delivery_expired_count }} ·
          {{ t.email.workflow_digest.failed.text }}: {{ row.delivery_failed_count }}
        </mj-text>
        {% endif %}
        {% if row.output_preview %}<mj-text font-size="13px" padding-top="0"><strong>{{ t.email.workflow_digest.message_preview.text }}:</strong><br />{{ row.output_preview | e | replace('\n', '<br />') }}</mj-text>{% endif %}
        <mj-button href="{{ row.workflow_url | e }}" background-color="#ff553b" color="#ffffff" border-radius="20px" font-size="16px" font-weight="bold" inner-padding="13px 22px">{{ t.email.workflow_digest.view_workflow.text }}</mj-button>
        <mj-text align="center" font-size="13px"><a href="{{ row.url | e }}">{{ t.email.workflow_digest.view_latest_run.text }}</a></mj-text>
      </mj-column></mj-section>
      {% endfor %}
      <mj-section><mj-column>
        {% if omitted_count %}<mj-text font-size="13px">{{ omitted_count }} {{ t.email.workflow_digest.more_workflows.text }}</mj-text>{% endif %}
        <mj-button href="{{ workflows_url | e }}" background-color="#ff553b" color="#ffffff" border-radius="20px" font-weight="bold" inner-padding="13px 22px">{{ t.email.workflow_digest.view_all.text }}</mj-button>
        <mj-text align="center" font-size="13px"><a href="{{ settings_url | e }}">{{ t.email.workflow_digest.settings.text }}</a></mj-text>
      </mj-column></mj-section>
    </mj-wrapper>
    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
