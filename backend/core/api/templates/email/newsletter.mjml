<mjml>
  <mj-head>
    <mj-title>{{ newsletter_title if newsletter_title else t.email.newsletter.title.text }}</mj-title>
    <mj-raw>
      <meta name="color-scheme" content="light only" />
      <meta name="supported-color-schemes" content="light" />
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="center" font-weight="bold" line-height="1.3"/>
      {% if darkmode %}
      <mj-text color="#e6e6e6" />
      {% else %}
      <mj-text color="#000000" />
      {% endif %}
    </mj-attributes>
    
    <!-- Include styles from separate file -->
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="{% if darkmode == False %}light-mode{% else %}dark-mode{% endif %}">
    <!-- Header -->
    {% if not hide_email_brand_header %}
    <mj-include path="./components/header.mjml" />
    {% endif %}
    
    <!-- Main Content -->
    {% if is_events_newsletter %}
    <mj-wrapper css-class="events-newsletter-shell" padding="0" padding-bottom="0" background-color="#ffffff">
    {% else %}
    <mj-wrapper css-class="content-box" padding="20px" padding-bottom="0">
    {% endif %}
      <mj-section padding-bottom="0">
        <mj-column>
          {% if newsletter_header_image_src %}
          {% if newsletter_header_mobile_image_src %}
          <mj-raw>
            <div style="text-align:center;padding:{{ newsletter_header_image_padding if newsletter_header_image_padding else '10px 25px 18px 25px' }};">
              <picture>
                <source media="(max-width:480px)" srcset="{{ newsletter_header_mobile_image_src }}" />
                <img src="{{ newsletter_header_image_src }}" width="600" alt="{{ newsletter_header_image_alt if newsletter_header_image_alt else 'Newsletter header' }}" style="display:block;border:0;border-radius:16px;height:auto;margin:0 auto;max-width:600px;width:100%;" />
              </picture>
            </div>
          </mj-raw>
          {% else %}
          <mj-image width="{{ newsletter_header_image_width if newsletter_header_image_width else '560px' }}" src="{{ newsletter_header_image_src }}" align="center" alt="{{ newsletter_header_image_alt if newsletter_header_image_alt else 'Newsletter header' }}" padding="{{ newsletter_header_image_padding if newsletter_header_image_padding else '10px 25px 18px 25px' }}" />
          {% endif %}
          {% else %}
          <mj-image width="50px" height="50px" src="{{ newsletter_header_icon_src if newsletter_header_icon_src else 'icons/mail.png' }}" align="center" alt="{{ newsletter_header_icon_alt if newsletter_header_icon_alt else 'Email icon' }}" css-class="email-icon-50" />
          <mj-text font-size="30px" padding-bottom="8px">
            <mark>{{ newsletter_title if newsletter_title else t.email.newsletter.title.text }}</mark>
          </mj-text>
          {% if newsletter_subtitle %}
          <mj-text font-size="22px" padding-bottom="8px">
            {{ newsletter_subtitle }}
          </mj-text>
          {% endif %}
          {% endif %}
        </mj-column>
      </mj-section>
      
      <!-- Newsletter Content (left-aligned, regular weight) -->
      <mj-section padding="0">
        <mj-column>
          {% if newsletter_content %}
          <mj-text css-class="{{ newsletter_content_class if newsletter_content_class else '' }}" align="left" font-weight="normal" padding="{{ newsletter_content_padding if newsletter_content_padding else '10px 25px 20px 25px' }}">
            {{ newsletter_content | safe }}
          </mj-text>
          {% else %}
          <mj-text align="left" font-weight="normal" padding-bottom="20px">
            {{ t.email.newsletter.default_content.text }}
          </mj-text>
          {% endif %}
        </mj-column>
      </mj-section>
      
      <!-- Call to Action (if provided) -->
      {% if cta_url and cta_text %}
      <mj-section padding="20px 0">
        <mj-column>
          <mj-button 
            href="{{ cta_url }}" 
            background-color="#ff553b" 
            color="#ffffff"
            border-radius="20px"
            font-size="16px"
            font-weight="bold"
            padding="12px 20px"
            inner-padding="13px 22px"
          >
            {{ cta_text }}
          </mj-button>
        </mj-column>
      </mj-section>
      {% endif %}
      
      <!-- Social Media Section (optional) -->
      {% if show_social_media %}
      <mj-section padding="20px 0">
        <mj-column>
          <mj-text font-size="18px" padding-bottom="15px">
            {{ t.email.newsletter.social_media_text.text }}
          </mj-text>
        </mj-column>
      </mj-section>
      
      <mj-section padding="10px 0">
        <mj-group>
          <mj-column width="33%">
            <mj-button
              href="{{ instagram_url if instagram_url else 'https://instagram.com/openmates_official' }}"
              background-color="#E4405F"
              color="#ffffff"
              border-radius="8px"
              font-size="16px"
              padding="12px 16px"
            >
              Instagram
            </mj-button>
          </mj-column>
          <mj-column width="33%">
            <mj-button
              href="{{ bluesky_url if bluesky_url else 'https://bsky.app/profile/openmates.bsky.social' }}"
              background-color="#0085FF"
              color="#ffffff"
              border-radius="8px"
              font-size="16px"
              padding="12px 16px"
            >
              Bluesky
            </mj-button>
          </mj-column>
          <mj-column width="33%">
            <mj-button
              href="{{ mastodon_url if mastodon_url else 'https://mastodon.social/@openmates' }}"
              background-color="#6364FF"
              color="#ffffff"
              border-radius="8px"
              font-size="16px"
              padding="12px 16px"
            >
              Mastodon
            </mj-button>
          </mj-column>
        </mj-group>
      </mj-section>
      {% endif %}
      
      <!-- Footer link: manage settings (registered users) or unsubscribe (non-registered) -->
      {% if manage_settings_url %}
      <mj-section padding="20px 0">
        <mj-column>
          <mj-text font-size="14px" color="#666666">
            {{ t.email.newsletter.manage_settings_text.text }}
            <a href="{{ manage_settings_url }}" style="color: #666666; text-decoration: underline;">
              {{ t.email.newsletter.manage_settings_link.text }}
            </a>
          </mj-text>
        </mj-column>
      </mj-section>
      {% elif unsubscribe_url %}
      <mj-section padding="20px 0">
        <mj-column>
          <mj-text font-size="14px" color="#666666">
            {{ t.email.newsletter.unsubscribe_text.text }}
            <a href="{{ unsubscribe_url }}" style="color: #666666; text-decoration: underline;">
              {{ t.email.newsletter.unsubscribe_link.text }}
            </a>
          </mj-text>
        </mj-column>
      </mj-section>
      {% endif %}
    </mj-wrapper>
    
    <!-- Footer -->
    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
