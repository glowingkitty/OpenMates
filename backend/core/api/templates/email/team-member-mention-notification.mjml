<mjml>
  <mj-head>
    <mj-title>{{ t.email.team_member_mention_notification.subject.text }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="center" font-weight="bold" line-height="1.3" />
    </mj-attributes>
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="light-mode">
    <mj-include path="./components/header.mjml" />
    <mj-wrapper css-class="content-box" padding="20px" padding-bottom="0">
      <mj-section>
        <mj-column>
          <mj-image width="50px" height="50px" src="icons/chat-bubble.png" align="center" css-class="email-icon-50" />
          <mj-text font-size="30px" padding-bottom="20px">
            <mark>{{ t.email.team_member_mention_notification.header.text }}</mark>
          </mj-text>
          <mj-text font-size="18px" padding-bottom="20px">
            {{ t.email.team_member_mention_notification.description.text }}
          </mj-text>
          <mj-button href="{{ chat_url }}" background-color="#6364FF" color="white" font-size="16px" font-weight="bold" border-radius="8px" padding="15px 30px">
            {{ t.email.team_member_mention_notification.open_chat_button.text }}
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
