<mjml>
  <mj-head>
    <mj-title>Billing processing error</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="center" font-weight="bold" line-height="1.3" />
      {% if darkmode %}
      <mj-text color="#e6e6e6" />
      {% else %}
      <mj-text color="#000000" />
      {% endif %}
    </mj-attributes>
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="{% if darkmode %}dark-mode{% else %}light-mode{% endif %}">
    <mj-include path="./components/header.mjml" />

    <mj-wrapper css-class="content-box" padding="20px" padding-bottom="0">
      <mj-section>
        <mj-column>
          <mj-image width="50px" height="50px" src="icons/warning.png" align="center" css-class="email-icon-50" />
          <mj-text font-size="30px" padding-bottom="24px">
            <mark>Billing processing error</mark>
          </mj-text>
          <mj-text font-size="16px" padding-bottom="16px">
            A billing invoice-processing task reported an error. Review the worker logs and accounting state before running any backfill.
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>Environment:</strong><br/>
            {{ environment }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>Stage:</strong><br/>
            {{ stage }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>Order ID:</strong><br/>
            {{ order_id }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>Provider:</strong><br/>
            {{ provider }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>Provider Order ID:</strong><br/>
            {{ provider_order_id }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>User ID hash:</strong><br/>
            {{ user_id_hash }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>Credits purchased:</strong><br/>
            {{ credits_purchased }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>User email send requested:</strong><br/>
            {{ send_email }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="10px">
            <strong>Error type:</strong><br/>
            {{ error_type }}
          </mj-text>
          <mj-text font-size="16px" padding-bottom="20px">
            <strong>Error message:</strong><br/>
            <pre style="background-color: {% if darkmode %}#2d2d2d{% else %}#f5f5f5{% endif %}; padding: 10px; border-radius: 4px; font-size: 12px; white-space: pre-wrap; word-wrap: break-word; text-align: left;">{{ error_message }}</pre>
          </mj-text>
          <mj-text font-size="14px" padding-bottom="30px" font-style="italic">
            Generated at {{ timestamp }}. The message is sanitized and excludes user email, PDF bytes, Vault values, and provider secrets.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
