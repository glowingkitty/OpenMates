<mjml>
  <mj-head>
    <mj-title>{{ t.email.workflow_completion.subject.text }}</mj-title>
    <mj-attributes><mj-all font-family="Arial, Helvetica, sans-serif" font-size="16px" align="left" line-height="1.4" /></mj-attributes>
    <mj-include path="./components/email-styles.mjml" />
  </mj-head>
  <mj-body css-class="{% if darkmode %}dark-mode{% else %}light-mode{% endif %}">
    <mj-include path="./components/header.mjml" />
    <mj-wrapper css-class="content-box" padding="20px">
      <mj-section><mj-column>
        <mj-text font-size="26px" font-weight="bold">{{ t.email.workflow_completion.heading.text }}</mj-text>
        {% if workflow_title %}<mj-text><strong>{{ workflow_title | e }}</strong></mj-text>{% endif %}
        <mj-text>{{ t.email.workflow_completion.detail.text }}</mj-text>
        <mj-button href="{{ url | e }}">{{ t.email.workflow_completion.view.text }}</mj-button>
      </mj-column></mj-section>
    </mj-wrapper>
    <mj-include path="./components/footer.mjml" />
  </mj-body>
</mjml>
