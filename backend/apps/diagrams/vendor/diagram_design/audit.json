  "source_review_findings": [
    {
      "finding": "MIT license and copyright retained",
      "action": "Full license copied beside pinned runtime assets."
    },
    {
      "finding": "Upstream style guide and three templates contained Google Fonts links",
      "action": "Removed remote font links; use locally bundled Lexend and system fallbacks."
    },
    {
      "finding": "Upstream guide required first-use host style onboarding and a confirmation pause",
      "action": "Removed the host gate; use the preconfigured OpenMates palette and request defaults."
    },
    {
      "finding": "Upstream guide and references cited local shell validators and file export/import helpers",
      "action": "Preserved geometric and accessibility checks as drawing guidance; removed shell invocations from runtime prompt."
    },
    {
      "finding": "Several type references said to halt and ask for ambiguous focal declarations",
      "action": "Adapted to choose from the user goal and state a material assumption; no automatic host approval gate."
    },
    {
      "finding": "No role-override or exfiltration instruction found in the copied 44 type references and common assets",
      "action": "Full selected references are resolved only by shipped IDs and verified SHA-256 revisions."
    },
    {
      "finding": "SVG-only dimensions can crop surrounding HTML composition",
      "action": "Templates and runtime instructions declare a whole-document artboard on html and a selected type on the SVG; generated dimensions must fit header, cards, padding, and footer."
    },
    {
      "finding": "Scaled preview surround must match the source page background",
      "action": "Root data-om-background declares the same resolved opaque six-digit #RRGGBB color as the body/artboard background in the guide and all three templates."
    }
  ],
