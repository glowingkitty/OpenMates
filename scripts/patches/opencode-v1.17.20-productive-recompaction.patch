+export function shouldStopAutomaticCompactionRetry(
+  messages: SessionV1.WithParts[],
+  currentUserID: MessageID,
+) {
+  const userIndex = messages.findLastIndex(
+    (message) => message.info.role === "user" && message.info.id === currentUserID,
+  )
+  if (userIndex < 0) return false
+  const user = messages[userIndex]
+  if (
+    user.info.role !== "user" ||
+    !user.parts.some(
+      (part) => part.type === "text" && part.synthetic && part.metadata?.compaction_continue === true,
+    )
+  ) {
+    return false
+  }
+  return !messages.slice(userIndex + 1).some(
+    (message) =>
+      message.info.role === "assistant" &&
+      message.info.summary !== true &&
+      message.info.time.completed !== undefined &&
+      message.info.error === undefined,
+  )
+}
