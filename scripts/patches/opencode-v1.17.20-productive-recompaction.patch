@@ -0,0 +1,83 @@
+import { expect, test } from "bun:test"
+import { ModelV2 } from "@opencode-ai/core/model"
+import { ProviderV2 } from "@opencode-ai/core/provider"
+import { SessionV1 } from "@opencode-ai/core/v1/session"
+import { MessageID, PartID, SessionID } from "../../src/session/schema"
+import { shouldStopAutomaticCompactionRetry } from "../../src/session/prompt"
+
+const sessionID = SessionID.make("ses_retry")
+const userID = MessageID.make("msg_retry_user")
+
+function automaticContinuation(): SessionV1.WithParts {
+  return {
+    info: {
+      id: userID,
+      role: "user",
+      sessionID,
+      time: { created: 1 },
+      agent: "build",
+      model: {
+        providerID: ProviderV2.ID.make("openai"),
+        modelID: ModelV2.ID.make("gpt-5.5"),
+      },
+    },
+    parts: [
+      {
+        id: PartID.make("prt_retry_user"),
+        messageID: userID,
+        sessionID,
+        type: "text",
+        text: "Continue",
+        synthetic: true,
+        metadata: { compaction_continue: true },
+      },
+    ],
+  }
+}
+
+function assistant(options: { completed?: boolean; error?: boolean } = {}): SessionV1.WithParts {
+  const id = MessageID.make(`msg_retry_assistant_${options.completed}_${options.error}`)
+  return {
+    info: {
+      id,
+      parentID: userID,
+      role: "assistant",
+      sessionID,
+      mode: "build",
+      agent: "build",
+      path: { cwd: "/repo", root: "/repo" },
+      cost: 0,
+      tokens: { input: 1, output: 1, reasoning: 0, cache: { read: 0, write: 0 } },
+      modelID: ModelV2.ID.make("gpt-5.5"),
+      providerID: ProviderV2.ID.make("openai"),
+      time: { created: 2, ...(options.completed ? { completed: 3 } : {}) },
+      ...(options.error
+        ? { error: { name: "ContextOverflowError", data: { message: "overflow" } } }
+        : {}),
+    },
+    parts: [],
+  } as SessionV1.WithParts
+}
+
+test("stops an immediate overflow after synthetic compaction continuation", () => {
+  expect(shouldStopAutomaticCompactionRetry([automaticContinuation()], userID)).toBe(true)
+  expect(
+    shouldStopAutomaticCompactionRetry(
+      [automaticContinuation(), assistant({ completed: true, error: true })],
+      userID,
+    ),
+  ).toBe(true)
+})
+
+test("allows another compaction after productive post-compaction progress", () => {
+  expect(
+    shouldStopAutomaticCompactionRetry([automaticContinuation(), assistant({ completed: true })], userID),
+  ).toBe(false)
+})
+
+test("does not apply the retry guard to an ordinary user prompt", () => {
+  const message = automaticContinuation()
+  const part = message.parts[0]
+  if (part?.type === "text") part.synthetic = false
+  expect(shouldStopAutomaticCompactionRetry([message], userID)).toBe(false)
+})
