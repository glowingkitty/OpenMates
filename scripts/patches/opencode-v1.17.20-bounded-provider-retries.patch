+describe("session.retry.policy", () => {
+  const attemptsFor = (error: SessionV1.APIError) =>
+    Effect.gen(function* () {
+      const attempts: number[] = []
+      const step = yield* Schedule.toStepWithMetadata(
+        SessionRetry.policy({
+          provider: "openai",
+          parse: Schema.decodeUnknownSync(SessionV1.APIError.Schema),
+          set: (info) =>
+            Effect.sync(() => {
+              attempts.push(info.attempt)
+            }),
+        }),
+      )
+
+      yield* Effect.forEach(Array.from({ length: SessionRetry.RETRY_MAX_RETRIES + 2 }), () =>
+        Effect.ignore(step(error)),
+      )
+      return attempts
+    })
+
+  it.instance("stops a repeated OpenAI 404 after one retry", () =>
+    Effect.gen(function* () {
+      const attempts = yield* attemptsFor(
