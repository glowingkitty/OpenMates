diff --git a/packages/opencode/test/session/model.test.ts b/packages/opencode/test/session/model.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/opencode/test/session/model.test.ts
@@ -0,0 +1,31 @@
+import { expect, test } from "bun:test"
+import { selectSessionModel } from "../../src/session/model"
+
+const model = (modelID: string) => ({ providerID: "provider", modelID })
+
+test("a bound session ignores a model leaked from another chat", () => {
+  expect(
+    selectSessionModel({
+      bound: model("bound"),
+      history: model("history"),
+      requested: model("global-request"),
+      fallback: model("fallback"),
+    }),
+  ).toEqual(model("bound"))
+})
+
+test("an existing unbound session migrates from history before request state", () => {
+  expect(
+    selectSessionModel({
+      history: model("history"),
+      requested: model("global-request"),
+      fallback: model("fallback"),
+    }),
+  ).toEqual(model("history"))
+})
+
+test("a new session binds its requested model", () => {
+  expect(selectSessionModel({ requested: model("requested"), fallback: model("fallback") })).toEqual(
+    model("requested"),
+  )
+})
