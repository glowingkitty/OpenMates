+++ b/packages/opencode/src/session/model.ts
@@ -0,0 +1,14 @@
+export type Model = {
+  providerID: string
+  modelID: string
+}
+
+export function selectSessionModel(input: {
+  bound?: Model
+  history?: Model
+  requested?: Model
+  agent?: Model
+  fallback: Model
+}) {
+  return input.bound ?? input.history ?? input.requested ?? input.agent ?? input.fallback
+}
