+    agent: Agent.Info,
+  ) {
+    const session = await Session.get(input.sessionID)
+    const model = selectSessionModel({
+      bound: session.model,
+      history: await historyModel(input.sessionID),
+      requested: input.model,
+      agent: agent.model,
+      fallback: await Provider.defaultModel(),
+    })
+    if (!session.model) {
+      await Session.update(input.sessionID, (draft) => {
+        draft.model ??= model
+      })
+    }
+    return model
+  }
