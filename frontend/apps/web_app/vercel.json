{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "cd ../../.. && pnpm --filter web_app build",
	"ignoreCommand": "cd ../../.. && python3 scripts/vercel_ignore_build.py",
	"installCommand": "cd ../../.. && corepack enable && pnpm install --no-frozen-lockfile",
	"rewrites": [
		{
			"source": "/dev/:path*",
			"destination": "/"
		},
		{
			"source": "/((?!_app|static|pii-runtime(?:/|$)|landing(?:/|$)|example(?:/|$)|events(?:/|$)|docs|status|announcements|news|blog|social|de/news|de/blog|de/social|tips|legal/|privacy|oauth/|s/|share/|favicon\\.ico|robots\\.txt|sitemap\\.xml|\\.well-known/apple-app-site-association).*)",
			"destination": "/"
		}
	],
	"headers": [
		{
			"source": "/pii-runtime/(.*).wasm",
			"headers": [
				{ "key": "Content-Type", "value": "application/wasm" },
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/pii-runtime/redact-4.1.0-litert-2.6.0/worker.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, must-revalidate"
				},
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'none'; connect-src 'none'; script-src blob: 'wasm-unsafe-eval'; worker-src 'none'; child-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				}
			]
		},
		{
			"source": "/pii-runtime/:version/version.json",
			"headers": [
				{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }
			]
		},
		{
			"source": "/pii-runtime/redact-4.1.0-litert-2.6.0/integrity.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, must-revalidate"
				}
			]
		},
		{
			"source": "/.well-known/apple-app-site-association",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/json"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		},
		{
			"source": "/",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, no-store, must-revalidate"
				}
			]
		},
		{
			"source": "/(.*).html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, no-store, must-revalidate"
				}
			]
		},
		{
			"source": "/_app/version.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, no-store, must-revalidate"
				}
			]
		},
		{
			"source": "/sw.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, no-store, must-revalidate"
				},
				{
					"key": "Service-Worker-Allowed",
					"value": "/"
				}
			]
		},
		{
			"source": "/_app/immutable/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
