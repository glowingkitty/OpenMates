[
  {
    "id": "berlin-ai-events",
    "title": "Weekly Berlin AI events",
    "summary": "Discover in-person AI events in Berlin for the coming week",
    "category": "science",
    "icon": "calendar-days",
    "graph": {
      "version": 2,
      "trigger_node_id": "trigger",
      "nodes": [
        {
          "id": "trigger",
          "type": "schedule_trigger",
          "title": "Scheduled check",
          "config": {
            "schedule": {
              "timezone": "Europe/Berlin",
              "type": "weekly",
              "weekdays": [
                "monday"
              ],
              "time": "09:00"
            }
          }
        },
        {
          "id": "search",
          "type": "app_skill_action",
          "config": {
            "app_id": "events",
            "skill_id": "search",
            "input": {
              "requests": [
                {
                  "query": "AI",
                  "location": "Berlin, Germany",
                  "event_type": "PHYSICAL",
                  "start_date": {
                    "$date": "next_seven_days_start",
                    "format": "datetime"
                  },
                  "end_date": {
                    "$date": "next_seven_days_end",
                    "format": "datetime"
                  },
                  "count": 10
                }
              ]
            }
          }
        },
        {
          "id": "message",
          "type": "send_chat_message",
          "config": {
            "title": "Berlin AI events",
            "message": "",
            "blocks": [
              {
                "id": "results",
                "source": "$nodes.search.output.results",
                "label": "Berlin AI events"
              }
            ]
          }
        }
      ],
      "edges": [
        {
          "from": "trigger",
          "to": "search"
        },
        {
          "from": "search",
          "to": "message"
        }
      ]
    }
  },
